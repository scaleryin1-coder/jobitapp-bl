{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["CUSTOMER", "WORKER", "ADMIN"] },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "role"]
    },
    "Worker": {
      "title": "Worker",
      "description": "Service professional profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "skills": { "type": "array" },
        "categories": { "type": "array" },
        "experienceYears": { "type": "number" },
        "serviceArea": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "rating": { "type": "number" },
        "totalJobsCompleted": { "type": "number" },
        "isAvailable": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "phone", "isVerified", "isAvailable"]
    },
    "Category": {
      "title": "Category",
      "description": "Service categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "iconName": { "type": "string" },
        "description": { "type": "string" },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Service": {
      "title": "Service",
      "description": "Specific sub-services with fixed task rates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "taskPrice": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "inclusions": { "type": "array" },
        "image": { "type": "string" }
      },
      "required": ["id", "categoryId", "name", "taskPrice"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Customer service booking order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "subServiceId": { "type": "string" },
        "subServiceName": { "type": "string" },
        "taskPrice": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["REQUESTED", "WORKER_ASSIGNED", "CONFIRMED", "IN_PROGRESS", "COMPLETED", "CANCELLED"] },
        "serviceAddress": { "type": "string" },
        "addressLandmark": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "scheduledSlot": { "type": "string" },
        "customerNotes": { "type": "string" },
        "workerNotes": { "type": "string" },
        "finalBillAmount": { "type": "number" },
        "commissionPercent": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PAID"] },
        "paymentMethod": { "type": "string", "enum": ["CASH"] },
        "user_latitude": { "type": "number" },
        "user_longitude": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId", "categoryId", "subServiceId", "taskPrice", "totalAmount", "status", "serviceAddress", "scheduledDate", "scheduledSlot"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and rating",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "customerId": { "type": "string" },
        "workerId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "bookingId", "customerId", "rating"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transaction records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "customerId": { "type": "string" },
        "workerId": { "type": "string" },
        "amount": { "type": "number" },
        "commissionPercent": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "workerAmount": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "bookingId", "customerId", "amount", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User in-app notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "bookingId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "isRead"]
    },
    "Address": {
      "title": "Address",
      "description": "Saved customer address",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "label": { "type": "string" },
        "fullAddress": { "type": "string" },
        "landmark": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "fullAddress"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Promo offers and coupons",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discountPercent": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "minOrder": { "type": "number" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "code", "discountPercent", "isActive"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Home promotional banners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "tag": { "type": "string" },
        "image": { "type": "string" },
        "serviceId": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "isActive"]
    },
    "DailyGig": {
      "title": "DailyGig",
      "description": "Urgent short-term daily job vacancies and shift gigs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "shop_name": { "type": "string" },
        "location": { "type": "string" },
        "wage": { "type": "string" },
        "duration": { "type": "string" },
        "timing": { "type": "string" },
        "category": { "type": "string" },
        "urgency": { "type": "string", "enum": ["urgent", "normal", "today"] },
        "contact_number": { "type": "string" },
        "whatsapp_number": { "type": "string" },
        "description": { "type": "string" },
        "employer_name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "filled", "expired"] },
        "created_at": { "type": "string" }
      },
      "required": ["id", "title", "shop_name", "location", "wage", "duration", "contact_number", "status"]
    },
    "WorkerPortfolio": {
      "title": "WorkerPortfolio",
      "description": "Worker portfolio work albums with photo gallery and project details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "worker_id": { "type": "string" },
        "category_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image_urls": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string" }
      },
      "required": ["id", "worker_id", "category_id", "title", "image_urls"]
    },
    "PendingWorker": {
      "title": "PendingWorker",
      "description": "Applicant worker profile pending admin KYC and trade verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "altPhone": { "type": "string" },
        "email": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "serviceRadius": { "type": "string" },
        "category": { "type": "string" },
        "categoryName": { "type": "string" },
        "categoryId": { "type": "string" },
        "skill": { "type": "string" },
        "skills": { "type": "array" },
        "categories": { "type": "array" },
        "subSkills": { "type": "array" },
        "experience": { "type": "string" },
        "experienceYears": { "type": "number" },
        "baseRate": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "workerStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "isVerified": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "liveSelfieUrl": { "type": "string" },
        "aadhaarNumber": { "type": "string" },
        "aadhaarDocUrl": { "type": "string" },
        "drivingLicenseNumber": { "type": "string" },
        "drivingLicenseDocUrl": { "type": "string" },
        "bankName": { "type": "string" },
        "accountHolderName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "ifscCode": { "type": "string" },
        "upiId": { "type": "string" },
        "rating": { "type": "number" },
        "totalJobsCompleted": { "type": "number" },
        "appliedAt": { "type": "string" },
        "submittedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "status"]
    }
  },
  "firestore": {
    "/pending_workers/{workerId}": {
      "schema": { "$ref": "#/entities/PendingWorker" },
      "description": "Worker applications awaiting admin approval"
    },
    "/worker_portfolios/{portfolioId}": {
      "schema": { "$ref": "#/entities/WorkerPortfolio" },
      "description": "Worker portfolio albums with photos"
    },
    "/daily_gigs/{gigId}": {
      "schema": { "$ref": "#/entities/DailyGig" },
      "description": "Short-term daily job vacancies and shift gigs"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents"
    },
    "/workers/{workerId}": {
      "schema": { "$ref": "#/entities/Worker" },
      "description": "Worker professional profiles"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Service categories"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Sub-services catalog"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Service bookings and orders"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Service reviews"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Payments and commissions"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/Address" },
      "description": "User saved addresses"
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "#/entities/Offer" },
      "description": "Coupons and promo offers"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Promotional banners"
    }
  }
}
