rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // USERS COLLECTION
    match /users/{userId} {
      allow read, write: if true;
    }

    // WORKERS COLLECTION (Online/Offline status, location, active job)
    match /workers/{workerId} {
      allow read, write: if true;
    }

    // PENDING WORKERS COLLECTION (Applications awaiting admin verification)
    match /pending_workers/{workerId} {
      allow read, write: if true;
    }

    // CATEGORIES COLLECTION
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // BANNERS COLLECTION
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // SERVICES COLLECTION
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // BOOKINGS COLLECTION (Real-time dispatch, customer, worker, and admin updates)
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // REVIEWS COLLECTION
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // DAILY GIGS & SHORT-TERM JOB VACANCIES
    match /daily_gigs/{gigId} {
      allow read, write: if true;
    }

    // WORKER PORTFOLIOS (Work albums with photo collections)
    match /worker_portfolios/{portfolioId} {
      allow read, write: if true;
    }

    // CHATS COLLECTION & SUBCOLLECTION
    match /chats/{bookingId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
