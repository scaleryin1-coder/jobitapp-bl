rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         getUserData().role == 'admin');
    }

    // USERS COLLECTION
    // users {name, phone, role: customer|worker|admin, photo, city}
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // CATEGORIES COLLECTION
    // categories {name, image, order}
    match /categories/{categoryId} {
      allow read: if true; // Public read so home screen and categories load instantly
      allow write: if isAdmin();
    }

    // BANNERS COLLECTION
    // banners {title, subtitle, image, serviceName, price, order, active}
    match /banners/{bannerId} {
      allow read: if true; // Public read for promotional carousel
      allow write: if isAdmin();
    }

    // SERVICES / WORKERS COLLECTION
    // services {workerId, categoryId, title, about, price, rating, reviewCount, ordersCompleted, gallery[], faqs[], city, available, approved}
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.workerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.workerId == request.auth.uid || 
        isAdmin() ||
        // Allow customer to increment ordersCompleted or review aggregates on booking/review
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount', 'ordersCompleted'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.workerId == request.auth.uid);
    }

    // BOOKINGS COLLECTION
    // bookings {customerId, workerId, serviceId, address, dateTime, note, status: pending|accepted|completed|cancelled}
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // REVIEWS COLLECTION
    // reviews {serviceId, customerId, rating, comment, createdAt}
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    // CHATS COLLECTION & SUBCOLLECTION
    // chats/{bookingId}/messages/{messageId}
    match /chats/{bookingId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
